{
  "manifest_version": 3,
  "name": "AI-Ready Context Clipper",
  "version": "0.1.0",
  "description": "Local-first context clipping. Foundation preview; clipping arrives in the next milestone.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "contextMenus", "storage", "activeTab"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open AI-Ready Context Clipper"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  }
}
